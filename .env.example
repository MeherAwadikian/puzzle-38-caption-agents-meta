# OpenRouter — used by the two caption agents
OPENROUTER_API_KEY=sk-or-v1-...

# Meta Graph API (from the meta_manager profile). The posting script derives a
# Page access token from the system-user token at runtime. Never commit real
# values.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ID=
META_GRAPH_API_VERSION=v21.0
